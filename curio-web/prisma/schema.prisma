generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STUDENT
}

model User {
  id        String   @id // Clerk userId
  email     String?
  role      Role     @default(STUDENT)
  firstName String?
  lastName  String?
  createdAt DateTime @default(now())

  //if this legacy/test user later "claims" with a live account, store the live clerk userId here
  linkedClerkUserId String?       @unique
  clerkEnv          String? // "test" | "live" | null
  accountClaim      AccountClaim?

  progresses      LessonProgress[]
  activeLesson    ActiveLesson?
  lessonLocations LessonLocation[]
  projectStarts   ProjectStart[]
  completions     ProjectCompletion[]
  schedules       ProjectSchedule[]
  lessonStates    LessonState[]
  circuitStates   CircuitState[]
  notebookState   NotebookState?
  profile         UserProfile?

  adminInvitesCreated AdminInvite[] @relation("AdminInviteCreatedBy")
  adminInvitesRevoked AdminInvite[] @relation("AdminInviteRevokedBy")
}

model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  projectSlug String
  lessonSlug  String
  stepKey     String
  status      String
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, projectSlug, lessonSlug, stepKey])
  @@index([userId, projectSlug, lessonSlug])
}

/**
 * (2) Current active project + active lesson pointer
 * one per user
 */
model ActiveLesson {
  userId      String   @id
  projectSlug String
  lessonSlug  String
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

/**
 * (3) Last-seen location inside a lesson
 * one row per (user, project, lesson)
 */
model LessonLocation {
  id          String   @id @default(cuid())
  userId      String
  projectSlug String
  lessonSlug  String
  lessonIndex Int
  stepIndex   Int
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, projectSlug, lessonSlug])
  @@index([userId, projectSlug])
}

/**
 * (4) StartedAt per project
 * one row per (user, project)
 */
model ProjectStart {
  id          String   @id @default(cuid())
  userId      String
  projectSlug String
  startedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, projectSlug])
  @@index([userId, startedAt])
}

/**
 * (5) Completion events
 * one row per (user, project)
 */
model ProjectCompletion {
  id                     String   @id @default(cuid())
  userId                 String
  projectSlug            String
  completedAt            DateTime @default(now())
  totalStepsAtCompletion Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, projectSlug])
  @@index([userId, completedAt])
}

/**
 * Dashboard schedule: days/week + hours/day (per project)
 * (you asked to sync schedule too)
 */
model ProjectSchedule {
  id          String   @id @default(cuid())
  userId      String
  projectSlug String
  daysPerWeek Int      @default(3)
  hoursPerDay Float    @default(2)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, projectSlug])
  @@index([userId, projectSlug])
}

model LessonState {
  id          String @id @default(cuid())
  userId      String
  projectSlug String
  lessonSlug  String

  // store blanks + editor blocks + edit regions in ONE json blob
  blanks Json @default("{}")

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, projectSlug, lessonSlug])
  @@index([userId, projectSlug, lessonSlug])
}

model UserProfile {
  userId String  @id
  age    Int?
  grade  String?
  school String?
  goals  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CircuitState {
  id          String @id @default(cuid())
  userId      String
  projectSlug String
  lessonSlug  String

  wokwiUrl    String?
  diagramJson Json? // store parsed JSON (or null)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, projectSlug, lessonSlug])
  @@index([userId, projectSlug, lessonSlug])
}

model NotebookState {
  userId    String   @id
  title     String   @default("Notebook")
  pagesJson Json     @default("{}") // stores pages index + page contents
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum AdminInviteType {
  EMAIL
  CODE
}

model AdminInvite {
  id String @id @default(cuid()) 

  email     String?
  type      AdminInviteType @default(EMAIL)

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  // created by
  createdByUserId String?
  createdByUser   User?   @relation("AdminInviteCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  revokedAt       DateTime?
  revokedByUserId String?
  revokedByUser   User?   @relation("AdminInviteRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)

  replacesInviteId String?

  @@index([email])
  @@index([revokedAt])
}

model AccountClaim {
  id           String    @id @default(cuid())
  legacyUserId String    @unique
  email        String
  tokenHash    String    @unique
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime  @default(now())

  legacyUser User @relation(fields: [legacyUserId], references: [id], onDelete: Cascade)

  @@index([email])
}

model Project {
  slug        String   @id
  title       String
  description String
  category    String?
  hours       String?
  image       String?
  available   Boolean  @default(false)
  sortOrder   Int      @default(0)

  // Optional extras (add now or later)
  difficulties Json?   // store ["Beginner","Intermediate"] etc as JSON array

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}