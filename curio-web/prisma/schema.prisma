generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


enum Role {
  ADMIN
  STUDENT
}

model User {
  id        String   @id          // store Clerk userId
  email     String?
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now())

  progresses LessonProgress[]
}

model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  projectSlug String
  lessonSlug  String
  stepKey     String
  status      String
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, projectSlug, lessonSlug, stepKey])
}

