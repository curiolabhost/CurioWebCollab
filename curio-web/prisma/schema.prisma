generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  projectSlug String
  lessonSlug  String
  stepKey     String
  status      String
  updatedAt   DateTime @updatedAt

  @@unique([userId, projectSlug, lessonSlug, stepKey])
}

