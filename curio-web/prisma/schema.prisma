generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STUDENT
}

model User {
  id        String   @id // Clerk userId
  email     String?
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now())

  progresses      LessonProgress[]
  activeLesson    ActiveLesson?
  lessonLocations LessonLocation[]
  projectStarts   ProjectStart[]
  completions     ProjectCompletion[]
  schedules       ProjectSchedule[]
  lessonStates    LessonState[]
  profile         UserProfile?
}

model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  projectSlug String
  lessonSlug  String
  stepKey     String
  status      String
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, projectSlug, lessonSlug, stepKey])
  @@index([userId, projectSlug, lessonSlug])
}

/**
 * (2) Current active project + active lesson pointer
 * one per user
 */
model ActiveLesson {
  userId      String   @id
  projectSlug String
  lessonSlug  String
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

/**
 * (3) Last-seen location inside a lesson
 * one row per (user, project, lesson)
 */
model LessonLocation {
  id          String   @id @default(cuid())
  userId      String
  projectSlug String
  lessonSlug  String
  lessonIndex Int
  stepIndex   Int
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, projectSlug, lessonSlug])
  @@index([userId, projectSlug])
}

/**
 * (4) StartedAt per project
 * one row per (user, project)
 */
model ProjectStart {
  id          String   @id @default(cuid())
  userId      String
  projectSlug String
  startedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, projectSlug])
  @@index([userId, startedAt])
}

/**
 * (5) Completion events
 * one row per (user, project)
 */
model ProjectCompletion {
  id                     String   @id @default(cuid())
  userId                 String
  projectSlug            String
  completedAt            DateTime @default(now())
  totalStepsAtCompletion Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, projectSlug])
  @@index([userId, completedAt])
}

/**
 * Dashboard schedule: days/week + hours/day (per project)
 * (you asked to sync schedule too)
 */
model ProjectSchedule {
  id          String   @id @default(cuid())
  userId      String
  projectSlug String
  daysPerWeek Int      @default(3)
  hoursPerDay Float    @default(2)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, projectSlug])
  @@index([userId, projectSlug])
}

model LessonState {
  id          String @id @default(cuid())
  userId      String
  projectSlug String
  lessonSlug  String

  // store blanks + editor blocks + edit regions in ONE json blob
  blanks Json @default("{}")

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, projectSlug, lessonSlug])
  @@index([userId, projectSlug, lessonSlug])
}

model UserProfile {
  userId String  @id
  age    Int?
  grade  String?
  school String?
  goals  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
